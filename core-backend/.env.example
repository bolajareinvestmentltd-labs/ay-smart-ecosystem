# Django backend environment example for Render + Supabase
# Copy this to core-backend/.env and replace values before deployment.

DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-secure-secret
DEBUG=False
ALLOWED_HOSTS=ay-smart-backend.onrender.com,localhost
# Use a full PostgreSQL connection string for your Render DB or Supabase/Neon Postgres database.
# Example: postgres://postgres:yourpassword@your-db-host.supabase.co:5432/postgres
DATABASE_URL=postgres://<username>:<password>@<host>:5432/<database_name>
CORS_ALLOWED_ORIGINS=https://aysmartinvestmentltd.com,https://www.aysmartinvestmentltd.com,http://localhost:3000

# Supabase config (optional host/anon/service keys if you want Supabase services later)
# These are separate from DATABASE_URL and are used for Supabase client services.
SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Paystack configuration
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_USE_TEST_MODE=true

# Email configuration
# For real email delivery, use SMTP or Resend with actual credentials.
# Do NOT use locmem or console backends if you want live email delivery.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_your_resend_api_key_here
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=support@aysmartinvestmentltd.com

# Resend API (recommended for production)
# If RESEND_API_KEY is set, Django will still use SMTP for email sending,
# while the verification helper sends messages through Resend if configured.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@resend.dev

# Frontend configuration used for verification links
FRONTEND_URL=https://aysmartinvestmentltd.com

# Legacy provider examples (optional)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_USE_TLS=True
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=postmaster@your-mailgun-domain
# EMAIL_HOST_PASSWORD=your-mailgun-smtp-password
# EMAIL_USE_TLS=True

# Webhook verification keys (optional but recommended)
RESEND_WEBHOOK_SIGNING_SECRET=your-resend-webhook-signing-secret
# MAILGUN_WEBHOOK_KEY=your-mailgun-webhook-signing-key
# SENDGRID_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
