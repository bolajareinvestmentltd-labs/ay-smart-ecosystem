# Django backend environment example for Render + Supabase
# Copy this to core-backend/.env and replace values before deployment.

DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-secure-secret
DEBUG=False
ALLOWED_HOSTS=ay-smart-backend.onrender.com,localhost
DATABASE_URL=postgres://<username>:<password>@<host>:5432/<database_name>
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Supabase config (optional host/anon/service keys if you want Supabase services later)
SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
